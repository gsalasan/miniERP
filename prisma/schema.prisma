generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChartOfAccounts {
  id              Int               @id @default(autoincrement())
  account_code    String            @unique
  account_name    String
  account_type    AccountType
  description     String?
  created_at      DateTime          @default(now())
  updated_at      DateTime
  journal_entries journal_entries[]
}

model FaseProyekLookup {
  id         String    @id
  name       String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  Service    Service[]
}

model Material {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  system                 String?
  subsystem              String?
  item_name              String
  brand                  String?
  owner_pn               String?
  vendor                 String?
  status                 MaterialStatus?
  location               MaterialLocation?
  cost_ori               Decimal?                @db.Decimal(14, 2)
  curr                   String?                 @db.VarChar(3)
  satuan                 String?                 @db.VarChar(50)
  cost_rp                Decimal?                @db.Decimal(14, 2)
  cost_date              DateTime                @default(now()) @db.Timestamptz(6)
  cost_validity          DateTime?               @db.Timestamptz(6)
  created_at             DateTime                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                @default(now()) @db.Timestamptz(6)
  components             Components?
  sbu                    String?
  kategori_sistem_id     String?                 @db.Uuid
  sub_sistem_id          String?                 @db.Uuid
  sbu_id                 String?                 @db.Uuid
  MaterialSystemCategory MaterialSystemCategory? @relation(fields: [kategori_sistem_id], references: [id], onUpdate: NoAction, map: "material_kategori_sistem_fk")
  SBULookup              SBULookup?              @relation(fields: [sbu_id], references: [id], onUpdate: NoAction, map: "material_sbu_fk")
  MaterialSubSystem      MaterialSubSystem?      @relation(fields: [sub_sistem_id], references: [id], onUpdate: NoAction, map: "material_sub_sistem_fk")
  rfp_items              rfp_items[]
  vendor_pricelist       vendor_pricelist[]

  @@index([kategori_sistem_id], map: "idx_material_kategori_sistem_id")
  @@index([sub_sistem_id], map: "idx_material_sub_sistem_id")
}

model MaterialSubSystem {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  system_category_id     String                 @db.Uuid
  created_at             DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?              @default(now()) @db.Timestamptz(6)
  Material               Material[]
  MaterialSystemCategory MaterialSystemCategory @relation(fields: [system_category_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "material_subsystem_fk_system")

  @@unique([name, system_category_id], map: "material_subsystem_name_category_unique")
}

model MaterialSystemCategory {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String              @unique
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @default(now()) @db.Timestamptz(6)
  Material          Material[]
  MaterialSubSystem MaterialSubSystem[]
}

model SBULookup {
  id         String     @id @db.Uuid
  name       String     @unique
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  Material   Material[]
}

model Service {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_name           String
  service_code           String                 @unique
  item_type              String                 @default("Service")
  unit                   ServiceUnit
  default_duration       Decimal?               @db.Decimal(10, 2)
  is_active              Boolean                @default(true)
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  kategori_sistem_id     String?
  sub_sistem_id          String?
  kategori_jasa_id       String?
  jenis_jasa_spesifik_id String?
  deskripsi_id           String?
  rekomendasi_tim_id     String?
  fase_proyek_id         String?
  sbu_id                 String?
  category               String?
  ServiceDescription     ServiceDescription?    @relation(fields: [deskripsi_id], references: [id])
  FaseProyekLookup       FaseProyekLookup?      @relation(fields: [fase_proyek_id], references: [id])
  ServiceSpecificType    ServiceSpecificType?   @relation(fields: [jenis_jasa_spesifik_id], references: [id])
  ServiceCategory        ServiceCategory?       @relation(fields: [kategori_jasa_id], references: [id])
  ServiceSystemCategory  ServiceSystemCategory? @relation(fields: [kategori_sistem_id], references: [id])
  TeamRecommendation     TeamRecommendation?    @relation(fields: [rekomendasi_tim_id], references: [id])
  ServiceSubSystem       ServiceSubSystem?      @relation(fields: [sub_sistem_id], references: [id])
  rfp_items              rfp_items[]

  @@index([deskripsi_id])
  @@index([fase_proyek_id])
  @@index([jenis_jasa_spesifik_id])
  @@index([kategori_jasa_id])
  @@index([kategori_sistem_id])
  @@index([rekomendasi_tim_id])
  @@index([sbu_id])
  @@index([sub_sistem_id])
}

model ServiceCategory {
  id         String    @id
  name       String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  Service    Service[]
}

model ServiceDescription {
  id         String    @id
  text       String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  Service    Service[]
}

model ServiceSpecificType {
  id          String    @id
  name        String
  category_id String
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  Service     Service[]

  @@unique([name, category_id])
  @@index([category_id])
}

model ServiceSubSystem {
  id                 String    @id
  name               String
  system_category_id String
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)
  Service            Service[]

  @@unique([name, system_category_id])
  @@index([system_category_id])
}

model ServiceSystemCategory {
  id         String    @id
  name       String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  Service    Service[]
}

model ServiceTeamMember {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id             String    @db.Uuid
  team_recommendation_id String
  created_at             DateTime? @default(now()) @db.Timestamptz(6)

  @@index([service_id], map: "idx_serviceteammember_service_id")
  @@index([team_recommendation_id], map: "idx_serviceteammember_team_rec_id")
}

model TeamRecommendation {
  id         String    @id
  name       String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  team_type  TeamType? @default(INTERNAL)
  Service    Service[]
}

model VendorCategoryLookup {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  value      String   @unique
  label      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([value], map: "vendor_category_lookup_value_idx")
}

model VendorClassificationLookup {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  value      String   @unique
  label      String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([value], map: "vendor_classification_lookup_value_idx")
}

model asset_depreciation_history {
  id                       Int          @id @default(autoincrement())
  asset_id                 Int
  period                   String       @db.VarChar(7)
  depreciation_expense     Decimal      @db.Decimal(15, 2)
  accumulated_depreciation Decimal      @db.Decimal(15, 2)
  book_value               Decimal      @db.Decimal(15, 2)
  created_at               DateTime     @default(now()) @db.Timestamp(6)
  fixed_assets             fixed_assets @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([asset_id, period])
  @@index([asset_id], map: "idx_depreciation_asset")
  @@index([period], map: "idx_depreciation_period")
}

model ce_cost_summary {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ce_document_id     String    @db.Uuid
  grouping_type      String?   @db.VarChar(50)
  group_key          String?   @db.VarChar(100)
  group_label        String?   @db.VarChar(255)
  item_count         Int?
  total_direct_cost  Decimal?  @db.Decimal(15, 2)
  total_markup       Decimal?  @db.Decimal(15, 2)
  total_sell_price   Decimal?  @db.Decimal(15, 2)
  pct_of_total_price Decimal?  @db.Decimal(5, 2)
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  updated_at         DateTime? @default(now()) @db.Timestamptz(6)

  @@index([ce_document_id], map: "idx_ce_cost_summary_ce_document_id")
}

model ce_line_items {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ce_document_id    String    @db.Uuid
  wbs_code          String?   @db.VarChar(20)
  task_name         String?   @db.VarChar(255)
  line_sequence     Int?
  cost_type         String?   @db.VarChar(50)
  sbu               String?   @db.VarChar(100)
  system_name       String?   @db.VarChar(100)
  subsystem_name    String?   @db.VarChar(100)
  cost_per_unit     Decimal?  @db.Decimal(15, 2)
  markup_percentage Decimal?  @db.Decimal(5, 2)
  total_markup      Decimal?  @db.Decimal(15, 2)
  pic_employee_id   String?   @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@index([ce_document_id], map: "idx_ce_line_items_ce_document_id")
}

model ce_task_timeline {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ce_document_id       String    @db.Uuid
  wbs_code             String?   @db.VarChar(20)
  task_name            String?   @db.VarChar(255)
  predecessor_wbs_code String?   @db.VarChar(20)
  start_date           DateTime? @db.Date
  end_date             DateTime? @db.Date
  duration_days        Int?
  pct_complete         Decimal?  @db.Decimal(5, 2)
  working_days         Decimal?  @db.Decimal(8, 2)
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  @@unique([ce_document_id, wbs_code], map: "ux_ce_task_timeline_ce_wbs")
  @@index([ce_document_id], map: "idx_ce_task_timeline_ce_document_id")
}

model customer_contacts {
  id          String    @id
  customer_id String
  name        String
  position    String?
  email       String?
  phone       String?
  whatsapp    String?   @db.VarChar(50)
  is_primary  Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
}

model customer_rekenings {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id    String    @db.VarChar
  bank_name      String?
  account_number String
  account_holder String?
  customers      customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customer_rekenings_customer")

  @@index([customer_id], map: "idx_customer_rekenings_customer_id")
}

model customers {
  id                   String                 @id
  customer_name        String
  channel              String
  city                 String
  status               CustomerStatus
  top_days             Int
  assigned_sales_id    String?
  credit_limit         Float?
  no_npwp              String?
  sppkp                String?
  created_at           DateTime               @default(now())
  updated_at           DateTime               @default(now())
  alamat               String?
  district             String?
  code                 String?                @db.VarChar(255)
  type                 String?                @db.VarChar(100)
  province             String?                @db.VarChar(255)
  sales_pic            String?                @db.VarChar(255)
  created_by           String?                @db.VarChar(255)
  lat                  Decimal?               @db.Decimal(10, 8)
  lng                  Decimal?               @db.Decimal(11, 8)
  customer_contacts    customer_contacts[]
  customer_rekenings   customer_rekenings[]
  customer_top_history customer_top_history[]
  users                users?                 @relation(fields: [sales_pic], references: [id], onUpdate: NoAction)
  estimations          estimations[]
  opportunities        opportunities[]
  projects             projects[]
  sales_itineraries    sales_itineraries[]
  sales_orders         sales_orders[]
}

model depreciation_history {
  id                       Int          @id @default(autoincrement())
  asset_id                 Int
  period                   String       @db.VarChar(7)
  depreciation_expense     Decimal      @db.Decimal(15, 2)
  accumulated_depreciation Decimal      @db.Decimal(15, 2)
  book_value               Decimal      @db.Decimal(15, 2)
  journal_entry_id         String?      @db.VarChar(255)
  created_at               DateTime?    @default(now()) @db.Timestamp(6)
  fixed_assets             fixed_assets @relation(fields: [asset_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([asset_id], map: "idx_depreciation_history_asset_id")
  @@index([period], map: "idx_depreciation_history_period")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model discount_policies {
  id                 String   @id
  role               String   @unique
  authority_limit    Decimal  @db.Decimal(5, 2)
  max_discount_limit Decimal  @db.Decimal(5, 2)
  description        String?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
}

model employees {
  id                          String                   @id
  full_name                   String
  position                    String
  hire_date                   DateTime
  basic_salary                Decimal                  @db.Decimal(15, 2)
  allowances                  Json?
  department                  String?
  blood_type                  BloodType?
  bank_name                   String?
  bank_account_number         String?
  npwp                        String?
  ptkp                        String?
  phone                       String?
  tax_id                      String?
  gender                      Gender?
  marital_status              MaritalStatus?
  employment_type             EmploymentType           @default(FULL_TIME)
  status                      EmployeeStatus           @default(ACTIVE)
  education_level             EducationLevel?
  manager_id                  String?                  @db.VarChar
  employee_id                 String?                  @unique @db.VarChar(255)
  first_name                  String?                  @db.VarChar(255)
  last_name                   String?                  @db.VarChar(255)
  email                       String?                  @unique @db.VarChar(255)
  personal_email              String?                  @db.VarChar(255)
  date_of_birth               DateTime?                @db.Timestamp(6)
  place_of_birth              String?                  @db.VarChar(255)
  nationality                 String?                  @default("Indonesian") @db.VarChar(255)
  religion                    String?                  @db.VarChar(255)
  current_address             String?
  permanent_address           String?
  city                        String?                  @db.VarChar(255)
  province                    String?                  @db.VarChar(255)
  postal_code                 String?                  @db.VarChar(20)
  country                     String?                  @default("Indonesia") @db.VarChar(255)
  ktp_number                  String?                  @db.VarChar(255)
  emergency_contact_name      String?                  @db.VarChar(255)
  emergency_contact_phone     String?                  @db.VarChar(255)
  emergency_contact_relation  String?                  @db.VarChar(255)
  probation_end_date          DateTime?                @db.Timestamp(6)
  confirmation_date           DateTime?                @db.Timestamp(6)
  contract_end_date           DateTime?                @db.Timestamp(6)
  termination_date            DateTime?                @db.Timestamp(6)
  last_working_date           DateTime?                @db.Timestamp(6)
  social_security_id          String?                  @db.VarChar(255)
  work_location               String?                  @db.VarChar(255)
  work_schedule               String?                  @db.VarChar(255)
  working_hours_per_week      Decimal?                 @db.Decimal(5, 2)
  university                  String?                  @db.VarChar(255)
  major                       String?                  @db.VarChar(255)
  graduation_year             Int?
  gpa                         Decimal?                 @db.Decimal(3, 2)
  certifications              Json?
  skills                      Json?
  languages                   Json?
  profile_picture             String?                  @db.VarChar(500)
  notes                       String?
  is_active                   Boolean?                 @default(true)
  created_at                  DateTime?                @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                @default(now()) @db.Timestamp(6)
  created_by                  String?                  @db.VarChar(255)
  updated_by                  String?                  @db.VarChar(255)
  sbu                         String?                  @db.VarChar(255)
  sales_tier                  String?                  @db.VarChar(255)
  role_type                   String?                  @db.VarChar(255)
  bpjs_kesehatan_number       String?                  @db.VarChar(255)
  bpjs_ketenagakerjaan_number String?                  @db.VarChar(255)
  bonus_this_month            Decimal?                 @default(0) @db.Decimal(18, 2)
  last_bonus_calculated_at    DateTime?                @db.Timestamp(6)
  payroll_opt_out             Boolean?                 @default(false)
  default_project_id          String?                  @db.VarChar(255)
  hr_payslip_adjustments      hr_payslip_adjustments[]
  users                       users?

  @@index([department], map: "idx_employees_department")
  @@index([email], map: "idx_employees_email")
  @@index([employee_id], map: "idx_employees_employee_id")
  @@index([manager_id], map: "idx_employees_manager_id")
  @@index([status], map: "idx_employees_status")
  @@index([sbu], map: "idx_employees_sbu")
}

model estimation_items {
  id                       String                  @id
  estimation_id            String
  item_id                  String
  item_type                ItemType
  quantity                 Decimal                 @db.Decimal(12, 4)
  source                   SourceType
  hpp_at_estimation        Decimal                 @db.Decimal(18, 2)
  sell_price_at_estimation Decimal                 @db.Decimal(18, 2)
  sub_category             String?                 @db.VarChar(100)
  item_name                String?
  unit                     String?                 @db.VarChar(20)
  cost_per_unit            Decimal?                @db.Decimal(18, 2)
  total_cost               Decimal?                @db.Decimal(18, 2)
  markup_pct               Decimal?                @db.Decimal(5, 4)
  notes                    String?
  category                 EstimationItemCategory?
  estimations              estimations             @relation(fields: [estimation_id], references: [id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model estimations {
  id                                            String             @id
  project_id                                    String
  version                                       Int
  status                                        EstimationStatus
  total_direct_hpp                              Decimal            @db.Decimal(18, 2)
  total_overhead_allocation                     Decimal            @db.Decimal(18, 2)
  total_hpp                                     Decimal            @db.Decimal(18, 2)
  total_sell_price                              Decimal            @db.Decimal(18, 2)
  assigned_to_user_id                           String?
  created_at                                    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                                    DateTime           @db.Timestamptz(6)
  requested_by_user_id                          String?
  technical_brief                               String?
  attachments                                   Json?
  ce_number                                     String?            @unique @db.VarChar(50)
  ce_date                                       DateTime?          @default(dbgenerated("CURRENT_DATE")) @db.Timestamptz(6)
  ce_period_start                               DateTime?          @db.Timestamptz(6)
  ce_period_end                                 DateTime?          @db.Timestamptz(6)
  client_name                                   String?            @db.VarChar(255)
  submitted_by_user_id                          String?            @db.Uuid
  submitted_at                                  DateTime?          @db.Timestamptz(6)
  approved_by_user_id                           String?            @db.Uuid
  approved_at                                   DateTime?          @db.Timestamptz(6)
  gross_margin_percentage                       Decimal?           @db.Decimal(5, 4)
  sales_pic                                     String?            @db.VarChar(255)
  date_requested                                DateTime?          @default(now()) @db.Timestamptz(6)
  date_assigned                                 DateTime?          @db.Timestamptz(6)
  date_started                                  DateTime?          @db.Timestamptz(6)
  date_completed                                DateTime?          @db.Timestamptz(6)
  client_id                                     String?
  requested_discount                            Decimal?           @db.Decimal(5, 2)
  approved_discount                             Decimal?           @db.Decimal(5, 2)
  discount_decision_reason                      String?
  so_number                                     String?            @db.VarChar(50)
  so_date                                       DateTime?          @db.Date
  sales_order_id                                String?
  name                                          String?            @db.VarChar(255)
  type                                          String?            @db.VarChar(20)
  total_sales                                   Decimal?           @db.Decimal(18, 2)
  created_by_user_id                            String?            @db.Uuid
  estimation_items                              estimation_items[]
  users_estimations_assigned_to_user_idTousers  users?             @relation("estimations_assigned_to_user_idTousers", fields: [assigned_to_user_id], references: [id])
  projects                                      projects           @relation(fields: [project_id], references: [id])
  users_estimations_requested_by_user_idTousers users?             @relation("estimations_requested_by_user_idTousers", fields: [requested_by_user_id], references: [id])
  sales_orders                                  sales_orders?      @relation(fields: [sales_order_id], references: [id], onUpdate: NoAction)
  customers                                     customers?         @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_estimations_client_id")

  @@unique([project_id, version], map: "estimations_project_version_unique")
  @@unique([project_id, version], map: "ux_estimations_project_id_version")
  @@index([sales_order_id], map: "idx_estimations_sales_order_id")
}

model exchange_rates {
  id             Int      @id @default(autoincrement())
  currency_from  String   @db.VarChar(3)
  currency_to    String   @db.VarChar(3)
  rate           Decimal  @db.Decimal(18, 6)
  effective_date DateTime @db.Date
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  @@unique([currency_from, currency_to, effective_date])
}

model fixed_assets {
  id                          Int                          @id @default(autoincrement())
  asset_name                  String                       @db.VarChar(255)
  asset_code                  String                       @unique @db.VarChar(50)
  category                    AssetCategory
  acquisition_date            DateTime                     @db.Date
  acquisition_cost            Decimal                      @db.Decimal(15, 2)
  residual_value              Decimal?                     @default(0) @db.Decimal(15, 2)
  useful_life_years           Int
  depreciation_method         String?                      @default("STRAIGHT_LINE") @db.VarChar(50)
  current_book_value          Decimal                      @db.Decimal(15, 2)
  accumulated_depreciation    Decimal?                     @default(0) @db.Decimal(15, 2)
  monthly_depreciation_amount Decimal?                     @default(0) @db.Decimal(15, 2)
  status                      AssetStatus?                 @default(ACTIVE)
  location                    String?                      @db.VarChar(255)
  notes                       String?
  created_by                  String?                      @db.VarChar(255)
  created_at                  DateTime?                    @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                    @default(now()) @db.Timestamp(6)
