{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../shared/*"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "module": "ESNext", 
    "moduleResolution": "Node"
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "vite.env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}