    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^8.15.0",
    "@mui/x-date-pickers": "^8.19.0",
    "axios": "^1.6.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.548.0",
    "minierp": "file:..",
    "notyf": "^3.10.0",
    "nprogress": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^4.12.0",
    "react-router-dom": "^7.9.4",
